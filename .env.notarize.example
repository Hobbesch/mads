# Apple-Credentials für die Notarisierung.
# Wird von scripts/build-signed.sh geladen. KOPIERE diese Datei zu ".env.notarize"
# (gitignored) und trage deine Werte ein. NIEMALS .env.notarize oder die .p8 committen.
#
# ── Methode A (empfohlen): App Store Connect API Key ───────────────────────────
#   1. https://appstoreconnect.apple.com  →  Users and Access  →  Integrations  →
#      "App Store Connect API"  →  Tab "Team Keys"  →  "+"  →  Rolle "Developer"
#      →  Generate.
#   2. Die .p8-Datei EINMALIG herunterladen (Apple zeigt sie nur einmal!) und
#      sicher außerhalb des Repos ablegen, z. B. unter ~/.appstoreconnect/private_keys/
#   3. "Key ID" (an der Zeile des Keys) und "Issuer ID" (oben auf der Seite) kopieren.
#
APPLE_API_KEY="REPLACE_WITH_KEY_ID"            # z. B. ABCD1234EF
APPLE_API_ISSUER="REPLACE_WITH_ISSUER_ID"      # UUID, oben auf der API-Keys-Seite
APPLE_API_KEY_PATH="/Users/alessandromedici/.appstoreconnect/private_keys/AuthKey_REPLACE_WITH_KEY_ID.p8"

# ── ODER Methode B: Apple ID + App-spezifisches Passwort ───────────────────────
#   App-spezifisches Passwort erstellen: https://appleid.apple.com  →  Anmelden  →
#   "App-spezifische Passwörter"  →  "+". Team-ID ist 726765YMVL (Medici Engineering GmbH).
#   Dann obige API-Zeilen auskommentieren und diese drei aktivieren:
# APPLE_ID="alessandro@medici.ch"
# APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
# APPLE_TEAM_ID="726765YMVL"
