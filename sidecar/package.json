{
  "name": "@mads/sidecar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "mads Node-Sidecar — orchestrates N Claude Code agents via the Claude Agent SDK",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "dev": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.183",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "~7.0.2"
  }
}
