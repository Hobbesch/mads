{
  "name": "mads",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "version:set": "node scripts/set-version.mjs",
    "release:mac": "bash scripts/build-signed.sh",
    "sidecar:build": "npm --prefix sidecar run build",
    "sidecar:install": "npm --prefix sidecar install",
    "test": "npm run test:ownership && npm run test:merge && npm run test:secrets && npm run test:collision && npm run test:safe && npm run test:autopilot && npm run test:adr && npm run test:hygiene && npm run test:persist && npm run test:outsource && npm run test:livepreview && npm run test:editops && npm run test:md && npm run test:ioredact && npm run test:agentenv && npm run test:derive && npm run test:reclaim && npm run test:perms && npm run test:release",
    "test:release": "esbuild sidecar/src/git-release.test.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/git-release.test.mjs && node node_modules/.cache/git-release.test.mjs",
    "test:ioredact": "esbuild sidecar/src/io.redact.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ioredact.test.mjs && node node_modules/.cache/ioredact.test.mjs",
    "test:agentenv": "esbuild sidecar/src/agentEnv.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/agentenv.test.mjs && node node_modules/.cache/agentenv.test.mjs",
    "test:derive": "esbuild src/derive.isMergedDone.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/derive.test.mjs && node node_modules/.cache/derive.test.mjs",
    "test:reclaim": "esbuild sidecar/src/git-reclaim.test.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/reclaim.test.mjs && node node_modules/.cache/reclaim.test.mjs",
    "test:perms": "esbuild sidecar/src/permissions.test.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/perms.test.mjs && node node_modules/.cache/perms.test.mjs",
    "test:autopilot": "esbuild shared/autopilot.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/autopilot.test.mjs && node node_modules/.cache/autopilot.test.mjs",
    "test:adr": "esbuild shared/adr.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/adr.test.mjs && node node_modules/.cache/adr.test.mjs",
    "test:hygiene": "esbuild shared/commit-hygiene.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hygiene.test.mjs && node node_modules/.cache/hygiene.test.mjs",
    "test:livepreview": "esbuild src/cmLivePreview.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/livepreview.test.mjs && node node_modules/.cache/livepreview.test.mjs",
    "test:persist": "esbuild sidecar/src/persistence.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/persist.test.mjs && node node_modules/.cache/persist.test.mjs",
    "test:outsource": "esbuild sidecar/src/git-outsource.test.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/outsource.test.mjs && node node_modules/.cache/outsource.test.mjs",
    "test:editops": "esbuild src/editOps.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/editops.test.mjs && node node_modules/.cache/editops.test.mjs",
    "test:ownership": "esbuild shared/ownership.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ownership.test.mjs && node node_modules/.cache/ownership.test.mjs",
    "test:merge": "esbuild shared/merge.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/merge.test.mjs && node node_modules/.cache/merge.test.mjs",
    "test:secrets": "esbuild shared/secrets.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/secrets.test.mjs && node node_modules/.cache/secrets.test.mjs",
    "test:collision": "esbuild shared/collision.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/collision.test.mjs && node node_modules/.cache/collision.test.mjs",
    "test:safe": "esbuild shared/safe-command.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/safe-command.test.mjs && node node_modules/.cache/safe-command.test.mjs",
    "test:md": "esbuild src/mdPipeline.smoke.test.tsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=node_modules/.cache/md.smoke.test.mjs && node node_modules/.cache/md.smoke.test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.21.0",
    "react": "^19.1.0",
    "react-arborist": "^3.10.5",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "^0.24.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
