{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mads-fs",
  "description": "Projekt-Explorer + Editor — nur watch über das Plugin; Read/Write via Custom-Command (doc 07 §4.3)",
  "windows": ["main"],
  "permissions": [
    "fs:allow-watch",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/mads-worktrees/**" }],
      "deny": [
        { "path": "$HOME/**/.git/**" },
        { "path": "$HOME/**/.env" },
        { "path": "$HOME/**/.env.*" },
        { "path": "$HOME/**/.ssh/**" },
        { "path": "$HOME/**/.aws/**" },
        { "path": "$HOME/**/node_modules/**" },
        { "path": "$HOME/**/target/**" }
      ]
    }
  ]
}
